# 讯飞
IFLYTEK_APP_ID=your-app-id
# 星火 HTTP 对话（文字）— 格式 apiKey:apiSecret，听写/TTS 也复用这一对
IFLYTEK_SPARK_HTTP_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
IFLYTEK_SPARK_API_PASSWORD=your-api-key:your-api-secret
IFLYTEK_SPARK_MODEL=4.0Ultra
# 可选：仅当不用 SPARK_API_PASSWORD 时才需要
# IFLYTEK_API_KEY=your-api-key
# IFLYTEK_API_SECRET=your-api-secret

# YOLO 物体检测（仅图片消息）
#
# 本地：
#   bash start-yolo.sh
#   YOLO_API_URL=http://127.0.0.1:8001
#
# 云端（Render / 阿里云 / Fly.io 等 Docker 部署 scripts/yolo-server）：
#   YOLO_API_URL=https://your-yolo-service.onrender.com
#   YOLO_API_KEY=与云端设置的相同密钥（可选但推荐）
YOLO_API_URL=http://127.0.0.1:8001
# YOLO_API_KEY=your-secret-key
